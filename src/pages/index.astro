---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { absolute, href, articleRoute, categories, readingMinutes } from '../lib/site.mjs';
import { getPosts } from '../lib/posts';

const route = '/';
const featuredPost = (await getPosts())[0];
const schema = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Adam Crest Farms',
  url: absolute('/'), logo: absolute('/assets/brand/adam-crest-farms-logo.jpeg'), foundingDate: '2026',
  address: { '@type': 'PostalAddress', streetAddress: 'Ologobi Village', addressLocality: 'Ede South', addressRegion: 'Osun State', addressCountry: 'NG' },
  sameAs: ['https://www.instagram.com/adamcrestfarms/', 'https://www.tiktok.com/@adamcrestfarms', 'https://www.facebook.com/profile.php?id=61596237654943']
};
---
<Base route={route} title="Adam Crest Farms | Crops & livestock in Osun State" description="Explore Adam Crest Farms in Ede South, Osun State: cucumbers, tomatoes, bell peppers, ostrich eggs and chicks, sheep and goats. Prices by quotation." image="/assets/farm/greenhouses.webp" imageAlt="Greenhouses at Adam Crest Farms" schema={schema}>
  <section class="front-cover" aria-labelledby="hero-title">
    <div class="wrap cover-layout">
      <div class="cover-type">
        <h1 id="hero-title">Crops &amp;<br /> livestock <em>in Osun.</em></h1>
        <p>We grow vegetables and raise ostriches, sheep and goats in Ologobi Village.</p>
        <a class="button button-gold" href="#offerings">Explore our products <svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a>
      </div>
      <img class="cover-photo" src={href(route, '/assets/farm/greenhouses.webp')} width="1280" height="720" alt="The greenhouses at Adam Crest Farms, with the farm sign on a tree beside the path" fetchpriority="high" />
    </div>
  </section>
  <section id="offerings" class="section wrap" aria-labelledby="products-title">
    <div class="section-heading">
      <h2 id="products-title">Our products</h2>
      <p>Prices by quotation. Availability varies with stock and harvest.</p>
    </div>
    <ProductGrid route={route} heading="h3" />
  </section>
  <section id="our-farm" class="home-story" aria-labelledby="story-title">
    <div class="section wrap story-spread">
      <img class="story-photo" src={href(route, '/assets/farm/nursery.webp')} width="960" height="1280" alt="The clear-roofed plant nursery at Adam Crest Farms" loading="lazy" />
      <div class="home-story-copy">
        <h2 id="story-title">Why we started <em>the farm.</em></h2>
        <p>We started Adam Crest Farms in 2026 to grow food and create work in agriculture. Today, farm managers, agronomists and farm staff look after our vegetables and livestock.</p>
        <div class="story-signoff">
          <a class="text-link" href={href(route, '/about/')}>About the farm <svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a>
          <img src={href(route, '/assets/mascot/ostrich-greeting.png')} width="1024" height="1536" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
  {featuredPost && <section id="journal" class="section wrap home-journal" aria-labelledby="journal-title">
    <div class="section-heading">
      <h2 id="journal-title">From the journal</h2>
      <a class="text-link" href={href(route, '/blog/')}>View all articles <svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a>
    </div>
    <article class="journal-feature">
      <a class:list={['journal-feature-art', { 'is-illustration': featuredPost.data.image.startsWith('/assets/mascot/') }]} href={href(route, articleRoute(featuredPost))} tabindex="-1" aria-hidden="true">
        <img src={href(route, featuredPost.data.image)} width={featuredPost.data.imageWidth} height={featuredPost.data.imageHeight} alt="" loading="lazy" />
      </a>
      <div class="journal-feature-copy">
        <p class="journal-feature-meta">{categories[featuredPost.data.category]} <span aria-hidden="true">·</span> {readingMinutes(featuredPost.body)} min read {featuredPost.data.status === 'draft' && <span class="draft-label">Draft preview</span>}</p>
        <h3><a href={href(route, articleRoute(featuredPost))}>{featuredPost.data.title}</a></h3>
        <p>{featuredPost.data.description}</p>
        <a class="text-link" href={href(route, articleRoute(featuredPost))} aria-label={'Read article: ' + featuredPost.data.title}>Read article <svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a>
      </div>
    </article>
  </section>}

  <section id="enquire" class="home-enquiry" aria-labelledby="form-title">
    <div class="section wrap contact-layout">
      <div class="home-enquiry-copy">
        <h2 id="form-title">Request a quote</h2>
        <p>Tell us what you need and how much. Copy your enquiry and send it to the farm on Instagram.</p>
        <a class="text-link" href={href(route, '/contact/')}>Contact details <svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a>
        <a id="whatsapp-link" class="button button-gold" href="#form-title" target="_blank" rel="noopener noreferrer" hidden>Continue on WhatsApp</a>
      </div>
      <div class="enquiry-card"><EnquiryForm /></div>
    </div>
  </section>
</Base>
