---
import Base from "../layouts/Base.astro";
import { absolute } from '../lib/site.mjs';
const schema = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Adam Crest Farms',
  url: absolute('/'), logo: absolute('/assets/brand/adam-crest-farms-logo.jpeg'),
  address: { '@type': 'PostalAddress', streetAddress: 'Ologobi Village', addressLocality: 'Ede South', addressRegion: 'Osun State', addressCountry: 'NG' },
  sameAs: ['https://www.instagram.com/adamcrestfarms/', 'https://www.tiktok.com/@adamcrestfarms', 'https://www.facebook.com/profile.php?id=61596237654943']
};
---
<Base route="/" title="Adam Crest Farms — Rooted in Osun. Growing for Nigeria." description="Meet Adam Crest Farms in Ologobi Village, Osun State. Explore our ostriches, sheep, goats and crops, and start a product enquiry." schema={schema}>

      <div class="opening">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">

          <h1 id="hero-title" class="entrance">Rooted in Osun.<br>Growing for<br><em>Nigeria.</em></h1>
          <p class="hero-intro entrance">Welcome to Adam Crest Farms. Discover our ostriches, sheep, goats and crops, and start a conversation about what you’re looking for.</p>
          <div class="hero-actions entrance"><a class="button button-gold" href="#offerings">Explore the farm <svg class="icon" aria-hidden="true" focusable="false"><use href="#arrow"/></svg></a></div>
        </div>
        <div class="hero-art entrance">
          <div class="mascot-stage">
            <div class="stage-sun" aria-hidden="true"></div>
            <span class="stage-label" aria-hidden="true">A LITTLE FARM SPIRIT</span>
            <img class="mascot" src="assets/mascot/ostrich-greeting.png" width="1024" height="1536" alt="Our friendly ostrich mascot, wearing a green neckerchief and raising a wing in welcome" fetchpriority="high">
            <span class="stage-note" aria-hidden="true">Oh, hello there.</span>
          </div>

        </div>
      </section>

  </div>

      <section id="offerings" class="offerings section wrap" aria-labelledby="offerings-title">
        <div class="section-intro"><p class="eyebrow">WHAT WE OFFER</p><h2 id="offerings-title">Livestock. <br>Crops. <br><em>Possibilities.</em></h2><p>Four parts of our farm. One place to start your next conversation.</p><p class="quiet-note">Current options, pricing and availability are confirmed directly with the farm.</p></div>
        <div class="offer-list">
          <article class="offer-row"><span class="offer-number">01</span><div><h3>Ostriches</h3><p>The distinctive bird at the heart of our identity. Get in touch about our ostriches.</p></div><a href="#enquire" data-product="Ostriches" aria-label="Enquire about ostriches"><svg class="icon" aria-hidden="true" focusable="false"><use href="#external"/></svg></a></article>
          <article class="offer-row"><span class="offer-number">02</span><div><h3>Sheep</h3><p>Looking for sheep? Tell us what you have in mind, and ask about current options.</p></div><a href="#enquire" data-product="Sheep" aria-label="Enquire about sheep"><svg class="icon" aria-hidden="true" focusable="false"><use href="#external"/></svg></a></article>
          <article class="offer-row"><span class="offer-number">03</span><div><h3>Goats</h3><p>Start an enquiry about our goats, with the details that matter to you.</p></div><a href="#enquire" data-product="Goats" aria-label="Enquire about goats"><svg class="icon" aria-hidden="true" focusable="false"><use href="#external"/></svg></a></article>
          <article class="offer-row"><span class="offer-number">04</span><div><h3>Crops</h3><p>Interested in what’s growing? Ask the farm which crops are currently available.</p></div><a href="#enquire" data-product="Crops" aria-label="Enquire about crops"><svg class="icon" aria-hidden="true" focusable="false"><use href="#external"/></svg></a></article>
        </div>
      </section>

      <section id="our-farm" class="farm-section" aria-labelledby="farm-title"><div class="wrap section farm-grid">
        <div class="roots-panel"><p class="eyebrow">OUR ROOTS</p><p class="roots-name">Osun<span>State.</span></p><div class="field-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div>
        <div class="farm-copy"><h2 id="farm-title">A place to grow.<br><em>A farm to know.</em></h2><p>Our home is Ologobi Village in Ede South. Our farm brings together ostriches, sheep, goats and crops, with a focus on quality products and healthy, well-fed livestock.</p><p>Whether you know exactly what you’re looking for or want to learn more, we’d like to hear from you.</p><a class="text-link dark-link" href="#enquire">Let’s start a conversation <svg class="icon" aria-hidden="true" focusable="false"><use href="#arrow"/></svg></a></div>
      </div></section>

      <section id="questions" class="section wrap questions-grid" aria-labelledby="questions-title"><div><p class="eyebrow">GOOD TO KNOW</p><h2 id="questions-title">Before you<br><em>get in touch.</em></h2></div><div class="questions-list">
        <details><summary>What is currently available?<span aria-hidden="true">+</span></summary><p>Availability and prices need to be confirmed directly with the farm. Choose ostriches, sheep, goats or crops in your enquiry and include what you’re looking for.</p></details>
        <details><summary>Can I arrange collection or delivery?<span aria-hidden="true">+</span></summary><p>Include your location when you enquire. Collection and delivery arrangements must be confirmed with the farm for your request.</p></details>
        <details><summary>Can I visit the farm?<span aria-hidden="true">+</span></summary><p>Please contact the farm before planning a visit. We’re based in Ologobi Village, Ede South, Osun State, Nigeria.</p></details>
      </div></section>

      <section id="enquire" class="enquiry-section" aria-labelledby="enquiry-title"><div class="wrap section enquiry-grid">
        <div class="enquiry-copy"><h2 id="enquiry-title">What are you<br><em>looking for?</em></h2><ol class="enquiry-steps"><li><span>01</span> Choose what interests you.</li><li><span>02</span> Add your details and copy the enquiry.</li><li><span>03</span> <span class="step-copy"><a data-instagram href="https://www.instagram.com/adamcrestfarms/" target="_blank" rel="noopener noreferrer">Open Instagram</a> and send your message.</span></li></ol><a id="whatsapp-link" class="button button-gold" href="#enquire" target="_blank" rel="noopener noreferrer" hidden>Continue on WhatsApp <svg class="icon" aria-hidden="true" focusable="false"><use href="#external"/></svg></a><p class="enquiry-note">Product details and next steps are confirmed directly with the farm.</p></div>
        <div class="enquiry-card"><form id="enquiry-form" aria-labelledby="enquiry-title"><div id="composer-fields" hidden><label for="product">I’m interested in</label><select id="product" name="product"><option>General enquiry</option><option>Ostriches</option><option>Sheep</option><option>Goats</option><option>Crops</option></select><label for="location">Your location</label><input id="location" name="location" type="text" autocomplete="address-level2" maxlength="120" placeholder="Town or state"><label for="details">What would you like to know? <span>(optional)</span></label><textarea id="details" name="details" rows="3" maxlength="1500" placeholder="Tell us the product, quantity or questions you have…"></textarea><button class="button button-forest" type="submit">Prepare my enquiry <svg class="icon" aria-hidden="true" focusable="false"><use href="#arrow"/></svg></button></div><noscript><h3>Start your farm enquiry</h3><p>Open our Instagram profile and send us a message about the products you’re interested in. The message composer needs JavaScript, but the social links in the footer work without it.</p></noscript></form>
          <div id="enquiry-result" hidden><label for="enquiry-message">Your prepared message</label><textarea id="enquiry-message" rows="7" readonly></textarea><button id="copy-enquiry" class="button button-forest" type="button">Copy enquiry <svg class="icon" aria-hidden="true" focusable="false"><use href="#arrow"/></svg></button></div><p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
      </div></section>

</Base>
